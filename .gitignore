# ignore bin directory
bin/

# `make examples` builds into bin/, but a bare `go build ./examples/<name>/`
# drops the executable in the working directory instead — and each is a ~2.5 MB
# platform-specific ELF that a `git add -A` will happily commit. Anchored to the
# repository root so the identically named package directories under examples/
# stay tracked.
/advanced_buffer
/device_info
/get_image
/list_devices
/performance_demo
/register_access

# test coverage artifacts (generated by `make test-coverage`)
coverage.out
coverage.html

# test log kept for the skip and GLib-diagnostic guards (`make test-glib-clean`)
test-output.txt
